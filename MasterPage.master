    </asp:ContentPlaceHolder>

    <!-- Critical Sticky Navbar Styles (Guaranteed across all browsers and devices) -->
    <style>
        @media (max-width: 991.98px) {
            .db-header {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                right: 0 !important;
                width: 100% !important;
                z-index: 1050 !important;
                background-color: #ffffff !important;
            }
            body.db-body {
                padding-top: 108px !important;
            }
        }
        @media (max-width: 375px) {
            body.db-body {
                padding-top: 92px !important;
            }
        }
        @media (min-width: 992px) {
            .db-header.is-sticky,
            .db-header.db-navbar-scrolled {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                right: 0 !important;
                width: 100% !important;
                z-index: 1050 !important;
            }
        }
    </style>
</head>
